{
  "ConnectionStrings": {
    "EquityLens": "Data Source=equitylens.db"
  },
  "ApiProviderOptions": {
    "Mode": "Live",
    "SecUserAgent": "EquityLens Portfolio App contact@example.com",
    "SupportedTickers": [ "AAPL", "MSFT", "NVDA", "TSLA", "GOOG", "AMZN" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
